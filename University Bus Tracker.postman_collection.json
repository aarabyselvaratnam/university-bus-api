{
  "info": {
    "_postman_id": "46c3a8bc-ec60-4c62-8ccc-2150c6703109",
    "name": "University Bus Tracker",
    "description": "The **University Bus Tracker** API collection provides a set of endpoints for managing and querying university bus schedules and fleet information.\n\nIt covers the following operations:\n\n- **Route Management** – Retrieve all available bus routes serving the university.\n    \n- **Schedule Queries** – Fetch bus schedules filtered by direction, including buses heading to the university and buses departing from it.\n    \n- **Bus Management** – Create, update, and delete bus entries in the system.\n    \n\nThis collection is intended for developers building or testing a university transportation system, enabling full control over bus data and real-time schedule lookups.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53920760",
    "_collection_link": "https://go.postman.co/collection/53920760-46c3a8bc-ec60-4c62-8ccc-2150c6703109?source=collection_link"
  },
